<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/w_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="小六壬占" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="小六壬 · 今日卦"
            android:textSize="10sp"
            android:textColor="#8a8578" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/w_gong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="大安"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#111111" />

            <TextView
                android:id="@+id/w_luck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="吉"
                android:textSize="14sp"
                android:textColor="#8a8578"
                android:paddingStart="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="农历正月初一"
            android:textSize="10sp"
            android:textColor="#8a8578" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <ImageView
            android:id="@+id/w_refresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_refresh"
            android:contentDescription="刷新" />

        <TextView
            android:id="@+id/w_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="身未动心安 · 诸事顺遂"
            android:textSize="10sp"
            android:textColor="#111111"
            android:maxLines="2" />
    </LinearLayout>
</LinearLayout>
